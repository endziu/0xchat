# Server port
PORT=3000

# Verbose logging
DEBUG=1

# Reverse proxy / edge IPs trusted to identify clients via X-Forwarded-For.
# Comma-separated, unscoped addresses (IPv6 zone identifiers are rejected).
# Unset: X-Forwarded-For is ignored entirely and rate limiting uses the direct
# peer IP. Set it to your proxy/edge IP(s) when the server sits behind one, or
# every client shares the proxy's IP.
TRUSTED_PROXY_IPS=

# Web Push VAPID keys — generate with `bunx web-push generate-vapid-keys`.
# Public key is also exposed unauthenticated at GET /api/push/vapid-public-key.
# Rotating these invalidates every existing push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
