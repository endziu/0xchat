# Server port
PORT=3000

# Verbose logging
DEBUG=1

# Web Push VAPID keys — generate with `bunx web-push generate-vapid-keys`.
# Public key is also exposed unauthenticated at GET /api/push/vapid-public-key.
# Rotating these invalidates every existing push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
