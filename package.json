{
  "name": "0xchat",
  "version": "0.4.4",
  "type": "module",
  "scripts": {
    "clear:db": "rm -f chat.db chat.db-shm chat.db-wal && echo 'DB cleared'",
    "clear:dist": "rm -rf dist && echo 'Dist cleared'",
    "clear:all": "bun clear:db; bun clear:dist",
    "build": "vite build",
    "icons": "bun run scripts/gen-icons.ts",
    "dev": "DEBUG=1 concurrently 'bun run server.ts' 'vite'",
    "start": "bun clear:db; bun run build; DEBUG=1 bun run server.ts",
    "start:prod": "bun run server.ts",
    "test": "bun clear:all && bun run build && bun test",
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "oxlint src server.ts"
  },
  "dependencies": {
    "@noble/secp256k1": "3.1.0",
    "jsqr": "^1.4.0",
    "lucide-preact": "^1.31.0",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4",
    "viem": "2.55.16",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.3.14",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "concurrently": "10.0.4",
    "oxlint": "1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
