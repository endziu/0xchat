{
  "name": "eth-chat",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clear:db": "rm -f chat.db chat.db-shm chat.db-wal && echo 'DB cleared'",
    "clear:dist": "rm -rf dist && echo 'Dist cleared'",
    "clear:all": "bun clear:db; bun clear:dist",
    "build": "vite build",
    "icons": "bun run scripts/gen-icons.ts",
    "dev": "DEBUG=1 concurrently 'bun run server.ts' 'vite'",
    "start": "bun clear:db; bun run build; DEBUG=1 bun run server.ts",
    "start:prod": "bun run server.ts",
    "test": "bun clear:all && bun run build && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src server.ts"
  },
  "dependencies": {
    "@noble/secp256k1": "3.0.0",
    "jsqr": "^1.4.0",
    "lucide-preact": "^0.474.0",
    "preact": "^10.29.0",
    "qrcode": "^1.5.4",
    "viem": "2.47.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.9.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "1.3.10",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "concurrently": "9.2.1",
    "oxlint": "0.16.6",
    "tailwindcss": "^4.2.2",
    "typescript": "5.6.3",
    "vite": "5.4.14"
  }
}
